# Public Supabase client config
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_jwt
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional but recommended for validation/logging
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

# Pooled runtime Postgres URL
# Username must be postgres.[PROJECT_REF]
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct Postgres URL for migrations
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Optional future Strava OAuth
# STRAVA_CLIENT_ID=your_strava_client_id
# STRAVA_CLIENT_SECRET=your_strava_client_secret
